# Copy to .env (never commit .env). Real environment variables override these.

# Leave DATABASE_URL unset to use local SQLite (db.sqlite3).
# For Supabase: Project → Connect.
#   Vercel (and the app):  Transaction pooler URI, port 6543
#   Running migrate from your Mac: Session pooler URI, port 5432
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Required when DJANGO_DEBUG=0 (always on Vercel). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# DJANGO_DEBUG=1
# SITE_NAME=Workbench

# Optional features
# ANTHROPIC_API_KEY=        # AI feedback in practice mode
# GITHUB_TOKEN=             # private repos + higher rate limit for commit import
# CRON_SECRET=              # protects the nightly demo reset (set the same value in Vercel)
# DEMO_ENABLED=1            # 0 hides "Try the demo"
# OWNER_URL=https://your-site.com   # linked from your name on the landing page
# REPO_URL=https://github.com/you/workbench
